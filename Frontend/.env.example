# Copy this file to ".env" in the same folder if you need to change it. The real .env is ignored by Git.
#
# Address of the backend API, used by "npm run dev".
# Nothing secret belongs here: every VITE_ value ends up in the built page and is visible to everyone.
# If you leave it out, the app uses http://localhost:5000.
# The Docker build sets it to empty so the page and the API share one address (Nginx).
VITE_API_URL=http://localhost:5000
