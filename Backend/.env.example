# Copy this file to ".env" in the same folder and fill in the empty values.
# The real .env file holds secrets. It is ignored by Git and must never be committed.
# Names are case sensitive on Linux: write them exactly as shown (APP_URL, not APP_URl).

# Required. Long random text used to sign login tokens. The app refuses to start without it.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Required. MongoDB address.
# Docker Compose ignores this value and uses its own MongoDB container.
MONGO_URI=mongodb://localhost:27017/ziplink

# Required. Public address that short links start with. Do not add a path.
# Docker Compose ignores this value and uses http://localhost:8080.
APP_URL=http://localhost:5000

# Address of the React app. Used for CORS and for sending visitors to pages like /expired.
# Docker Compose ignores this value and uses http://localhost:8080.
FRONTEND_URL=http://localhost:5173

# Port the backend listens on.
PORT=5000

# Optional. Redis address, for example redis://localhost:6379
# Leave empty to run without Redis: no cache, no rate limits, clicks saved straight to MongoDB.
# Docker Compose ignores this value and uses its own Redis container.
REDIS_URL=

# Optional. How many reverse proxies sit in front of the backend. Nginx in Docker Compose is 1.
# Leave 0 when nothing is in front, otherwise visitors could fake their address.
TRUST_PROXY=0

# Optional. "production" makes login cookies Secure, which only works over HTTPS.
NODE_ENV=development

# Optional Google sign-in. All three must be filled in, otherwise Google sign-in stays off.
# See "Google sign-in setup" in the README. Never put these values in the Frontend folder.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI in Google Cloud Console exactly.
# Without Docker:      http://localhost:5000/api/auth/google/callback
# Docker Compose uses: http://localhost:8080/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
